NODE_ENV=development
PORT=5000

DATABASE_URL=
# Optional provider-issued PEM CA for verified remote database TLS.
DATABASE_SSL_CA=
# Alternatively, a local certificate path (Render may use a mounted secret file).
DATABASE_SSL_CA_FILE=

# Public browser API: allow requests from any origin.
CORS_ORIGIN=*

API_VERSION=v1

# OIDC resource-server configuration. Business routes fail closed until set.
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URL=
AUTH_ALLOWED_ALGORITHMS=RS256,ES256
AUTH_CLOCK_TOLERANCE_SECONDS=5
